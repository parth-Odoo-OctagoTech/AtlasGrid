# ==============================================================================
# GridPulse - Global Infrastructure Observability Platform Configuration
# ==============================================================================

# ENTSO-E Transparency Platform API Token (Europe Real-Time Dispatch)
# Register and request token at: https://transparency.entsoe.eu/
ENTSOE_API_KEY=your_entsoe_api_token_here

# US Energy Information Administration (EIA) API Key v2
# Register at: https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key_here

# Optional: Mapbox Access Token (If using Mapbox custom dark tiles instead of default MapLibre/Carto Dark Matter)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Optional: Custom Vector Tile / Basemap Style URL
# Defaults to Carto Dark Matter: https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
NEXT_PUBLIC_BASEMAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Optional: PostgreSQL / PostGIS Database Connection URL (Fallback to in-memory GeoJSON if not provided)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/powergrid_db

# Telemetry Simulation Interval in milliseconds (default: 3000ms)
NEXT_PUBLIC_TELEMETRY_REFRESH_MS=3000
